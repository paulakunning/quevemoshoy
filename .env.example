# TMDB "API Read Access Token" (the long one, not the API key):
# https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Groq API key, for the AI text search: https://console.groq.com/keys
GROQ_API_KEY=

# Neon Postgres connection string, for the AI search limit: https://console.neon.tech
# Locally, use the dev branch, never production
DATABASE_URL=

# Secret mixed into each IP before hashing it, so the stored hashes can't be
# reversed. Generate one with: openssl rand -hex 32
IP_HASH_SALT=

# AI searches allowed per day for everyone together (optional, 60 by default)
AI_DAILY_LIMIT=
